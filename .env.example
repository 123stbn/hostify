# ==============================================================================
# HOSTIFY: VARIABLES DE ENTORNO (.env)
# ==============================================================================

# Identidad del sistema (Linux PUID / PGID)
PUID=1000
PGID=10
TZ=America/Lima

# Puertos expuestos en el Host
HOSTIFY_PORT=3000
NAVIDROME_PORT=4533
FEISHIN_PORT=9188

# Almacenamiento Principal (Rutas en el Servidor / NAS)
# MUSIC_ROOT contiene las subcarpetas: /explo, /slskd y /torrents
MUSIC_ROOT=/volume1/music
DOCKER_DATA=/volume1/docker

# Configuración de Navidrome & Proxy Reverso
# Si usas dominio propio (ej. https://music.midominio.com), colócalo en BASE_URL
BASE_URL=
REVERSE_PROXY_USER_HEADER=
REVERSE_PROXY_WHITELIST=

# Scrobbling a ListenBrainz
# Obtén tu User Token en: https://listenbrainz.org/profile/
LZ_USER=
LZ_TOKEN=

# Soulseek / Slskd (P2P Music Network)
SLSKD_USERNAME=hostify_user
SLSKD_PASSWORD=hostify_pass
SLSKD_API_KEY=hostify_super_secret_key_123

# Lidarr & Prowlarr (*arr automation & indexers)
LIDARR_API_KEY=hostify_lidarr_secret_api_key_32c
PROWLARR_API_KEY=hostify_prowlarr_secret_api_key_32c
