{
  "name": "hostify-appliance",
  "version": "1.0.0",
  "description": "Hostify - Turnkey Personal Music Cloud Setup Wizard & Management Dashboard",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev:standalone": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm run build:client && pnpm run build:server",
    "start": "NODE_ENV=production node dist/server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
