{
  "name": "hostify-appliance",
  "version": "1.0.0",
  "description": "Hostify - Turnkey Personal Music Cloud Setup Wizard & Management Dashboard",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs --external:vite --external:http-proxy-middleware",
    "build": "pnpm run build:client && pnpm run build:server",
    "test": "tsx --test server/**/*.test.ts",
    "start": "NODE_ENV=production node dist/index.cjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
